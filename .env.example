# Configuración de Red y Seguridad del Asistente Lili
# Copia este archivo a .env y completa los valores correspondientes.

# * Token de seguridad compartido entre todos los nodos (Mac, CachyOS, Windows)
INTERNAL_AUTH_TOKEN=cambiar_este_token_secreto_por_uno_seguro

# * Configuración del Orquestador (MacBook Air)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# * Configuración de Ollama (CachyOS)
# ! Asegúrate de que Ollama escuche en la red local (OLLAMA_HOST=0.0.0.0:11434)
OLLAMA_HOST=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.2:3b

# * Configuración de Clientes Remotos (Valores por defecto si no usan auto-discovery)
CACHYOS_CLIENT_URL=http://192.168.1.50:5001
WINDOWS_CLIENT_URL=http://192.168.1.60:5002

# * APIs Externas (Opcional)
OPENWEATHER_API_KEY=tu_api_key_de_openweather
OPENWEATHER_CITY=Monterrey
